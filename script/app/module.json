        "args": ["--file", "$root/examples/polymarket_patterns.toad"],
        "program": "${artifact:toad}"
      }
    },
    "toad": {
      "kind": "executable",
      "sources": {
        "files": ["main.c"]
      },
      "private": {
        "deps": ["toad_script", "saltsutils_databind", "cmeta_plugin"],
        "defines": {
          "TOAD_SCRIPT_USE_SHARED": null
        }
      },
      "runtimeDeps": ["fin", "ta", "ts", "net"],
      "variants": [
        {
          "when": {
            "os": "android"
          },
          "private": {
            "linkFlags": ["-Wl,-z,max-page-size=16384"]
          }
        }
      ]
    },
    "toad_script_cli_uses_actual_module_names_case": {
      "kind": "header_only",
      "when": {
        "native": true
      },
      "runtimeDeps": ["toad", "fin", "ta", "ts", "net"],
      "test": {
        "name": "toad_script_cli_uses_actual_module_names",
        "labels": ["cli", "plugins", "toad_script"],
        "args": [
          "--eval",
          "import(\"fin\"); import(\"ts\"); module_names_ok = 1;"
        ],
        "program": "${artifact:toad}"
      }
    }
  }
}
