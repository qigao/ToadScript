{
  "targets": {
    "saltsbase_core": {
      "kind": "prebuilt",
      "public": {
        "defines": {
          "HAS_ZSTD": "1"
        }
      },
      "variants": [
        {
          "when": {
            "os": "windows",
            "driver": "llvm-mingw"
          },
          "public": {
            "libs": ["${envPath:SALTS_BASE_ROOT}/lib/libsalts.dll.a"],
            "requiredIncludeDirs": ["${envPath:SALTS_BASE_ROOT}/include"]
          },
          "runtimeBins": ["${envPath:SALTS_BASE_ROOT}/bin/libsalts.dll"]
        },
        {
          "when": {
            "os": "windows",
            "driver": "msvc"
          },
          "public": {
            "libs": ["${envPath:TURBOSCRIPT_MSVC_SALTS_BASE_ROOT}/lib/salts.lib"],
            "requiredIncludeDirs": ["${envPath:TURBOSCRIPT_MSVC_SALTS_BASE_ROOT}/include"]
          },
          "runtimeBins": ["${envPath:TURBOSCRIPT_MSVC_SALTS_BASE_ROOT}/bin/salts.dll"]
        },
        {
          "when": {
            "os": ["linux", "android"]
          },
          "public": {
            "libs": ["${envPath:SALTS_BASE_ROOT}/lib/libsalts.so"],
            "requiredIncludeDirs": ["${envPath:SALTS_BASE_ROOT}/include"]
          },
          "runtimeBins": ["${envPath:SALTS_BASE_ROOT}/lib/libsalts.so"]
        },
        {
          "when": {
            "os": "macos"
          },
          "public": {
            "libs": ["${envPath:SALTS_BASE_ROOT}/lib/libsalts.dylib"],
            "requiredIncludeDirs": ["${envPath:SALTS_BASE_ROOT}/include"]
          },
          "runtimeBins": ["${envPath:SALTS_BASE_ROOT}/lib/libsalts.dylib"]
        }
      ]
    },
