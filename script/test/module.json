    "test_script_host_plugin": {
      "kind": "executable",
      "testOnly": true,
      "when": {
        "native": true
      },
      "sources": {
        "files": ["test_script_host_plugin.cpp"]
      },
      "private": {
        "deps": ["toad_script", "saltsbase_tinytest", "cmeta_plugin"],
        "defines": {
          "TOAD_SCRIPT_USE_SHARED": null
        }
      },
      "variants": [
        {
          "when": {
            "os": ["linux", "android"]
          },
          "private": {
            "linkFlags": ["-pthread"],
            "defines": {
              "CALIBRATION_PATH": "\"$builddir/plugins/example_calibration.so\"",
              "INTERFACE_PATH": "\"$builddir/plugins/loader_fixture.so\"",
              "MAINTENANCE_PATH": "\"$builddir/plugins/example_maintenance.so\"",
              "SCALARS_PATH": "\"$builddir/plugins/test_host_plugin_scalars.so\"",
              "UNKNOWN_PATH": "\"$builddir/plugins/test_host_plugin_unknown_result.so\""
            }
          }
        },
        {
          "when": {
            "os": "windows"
          },
          "private": {
            "defines": {
              "CALIBRATION_PATH": "\"$builddir/plugins/example_calibration.dll\"",
              "INTERFACE_PATH": "\"$builddir/plugins/loader_fixture.dll\"",
              "MAINTENANCE_PATH": "\"$builddir/plugins/example_maintenance.dll\"",
              "SCALARS_PATH": "\"$builddir/plugins/test_host_plugin_scalars.dll\"",
              "UNKNOWN_PATH": "\"$builddir/plugins/test_host_plugin_unknown_result.dll\""
            }
          }
        },
        {
          "when": {
            "os": "macos"
          },
          "private": {
            "defines": {
              "CALIBRATION_PATH": "\"$builddir/plugins/example_calibration.dylib\"",
              "INTERFACE_PATH": "\"$builddir/plugins/loader_fixture.dylib\"",
              "MAINTENANCE_PATH": "\"$builddir/plugins/example_maintenance.dylib\"",
              "SCALARS_PATH": "\"$builddir/plugins/test_host_plugin_scalars.dylib\"",
              "UNKNOWN_PATH": "\"$builddir/plugins/test_host_plugin_unknown_result.dylib\""
            }
