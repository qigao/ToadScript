{
  "tools": {
    "cmake": {
      "program": "cmake"
    },
    "re2c": {
      "program": "${envPath:TURBOSCRIPT_RE2C_ROOT}/bin/re2c${host:exe}"
    },
    "lemon": {
      "program": "${envPath:LEMON_ROOT}/bin/lemon${host:exe}"
    },
    "salts-idlc": {
      "program": "cmake",
      "args": [
        "-E",
        "env",
        "--modify",
        "PATH=path_list_prepend:${envPath:SALTS_BASE_ROOT}/bin",
        "--modify",
        "PATH=path_list_prepend:${envPath:SALTS_UTILS_ROOT}/bin",
        "--modify",
        "LD_LIBRARY_PATH=path_list_prepend:${envPath:SALTS_BASE_ROOT}/lib",
        "--modify",
        "LD_LIBRARY_PATH=path_list_prepend:${envPath:SALTS_UTILS_ROOT}/lib",
        "--modify",
        "DYLD_LIBRARY_PATH=path_list_prepend:${envPath:SALTS_BASE_ROOT}/lib",
        "--modify",
        "DYLD_LIBRARY_PATH=path_list_prepend:${envPath:SALTS_UTILS_ROOT}/lib",
        "--",
        "${envPath:SALTS_UTILS_ROOT}/bin/salts-idlc${host:exe}"
      ]
    },
    "msvc-salts-idlc": {
      "program": "cmake",
      "args": [
        "-E",
        "env",
        "--modify",
        "PATH=path_list_prepend:${envPath:TURBOSCRIPT_MSVC_SALTS_BASE_ROOT}/bin",
        "--modify",
        "PATH=path_list_prepend:${envPath:TURBOSCRIPT_MSVC_SALTS_UTILS_ROOT}/bin",
        "--modify",
        "LD_LIBRARY_PATH=path_list_prepend:${envPath:TURBOSCRIPT_MSVC_SALTS_BASE_ROOT}/lib",
        "--modify",
        "LD_LIBRARY_PATH=path_list_prepend:${envPath:TURBOSCRIPT_MSVC_SALTS_UTILS_ROOT}/lib",
        "--modify",
        "DYLD_LIBRARY_PATH=path_list_prepend:${envPath:TURBOSCRIPT_MSVC_SALTS_BASE_ROOT}/lib",
        "--modify",
        "DYLD_LIBRARY_PATH=path_list_prepend:${envPath:TURBOSCRIPT_MSVC_SALTS_UTILS_ROOT}/lib",
        "--",
        "${envPath:TURBOSCRIPT_MSVC_SALTS_UTILS_ROOT}/bin/salts-idlc${host:exe}"
      ]
    }
  }
}
