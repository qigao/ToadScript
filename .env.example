# Load build settings into the parent shell before invoking CMake presets.
# The local restore wrapper loads these nonsecret fields from .env with -Local.
# Use forward slashes in absolute paths. Keep credentials out of this file.
VSDEVCMD_BAT=C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/Common7/Tools/VsDevCmd.bat
VCPKG_ROOT=C:/tools/vcpkg
VCPKG_CACHE_REPOSITORY_ROOT=C:/path/to/clean/vcpkg-cache-v0.1.3
CMAKE_BUILD_PARALLEL_LEVEL=8
MSVC_TARGET_TRIPLET=x64-windows

# Exact published release versions, without v. CI uses variables of these names.
VCPKG_CACHE_VERSION=0.1.3
SALTS_BASE_VERSION=0.1.5
CMETA_VERSION=0.1.5
SALTS_UTILS_VERSION=0.1.2
SALTS_CORE_VERSION=0.1.11
TURBODB_VERSION=0.1.0
# Latest published CHttp prerelease as of 2026-11-12. It still requires the old
# monolithic Salts SDK and BLOCKS split-SDK configuration. Do not mix ABI families.
# Replace with a compatible published split-SDK release when one is available.
CHTTP_VERSION=2.1.0-rc.6

# restore-native-sdks.ps1 sets SALTS_BASE_ROOT, CMETA_ROOT, SALTS_UTILS_ROOT,
# SALTSCORE_ROOT, TURBODB_ROOT, CHTTP_ROOT, RE2C_ROOT, LEMON_ROOT and
# VCPKG_INSTALLED_DIR to this round's versioned installations.
# Supply GITHUB_TOKEN in the parent environment for the read-only NuGet feed;
# local restoration may use an authenticated gh login. Never commit credentials.

# Other compiler profiles require matching published SDKs and toolchain setup.
# LLVM_NATIVE_TARGET_TRIPLET=x64-linux
# GCC_TARGET_TRIPLET=x64-linux
# GCC_C_COMPILER=gcc
# GCC_CXX_COMPILER=g++
# LLVM_MINGW_ROOT=C:/tools/llvm-mingw
# LLVM_MINGW_TARGET=x86_64-w64-mingw32
# LLVM_MINGW_TOOLCHAIN_FILE=C:/path/from/setup-llvm-mingw/toolchain.cmake
# ANDROID_NDK_HOME=C:/path/to/android-ndk
# Android target: -Rid android-arm64-v8a -HostRid linux-x64
